<!doctype html>
<html class="no-js" lang="">

<head>
    <meta charset="utf-8">
    <title>{{ name }}</title>
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
            {% include "themes/base.css" %}
    </style>
</head>

<body class="run-summary">
    <h1>{{ name }}</h1>
    <div class="header">
        {% include "header.html.jinja2" %}
    </div>

    <a href="#index" class="index-link-button">🏠 Home</a>

    <div class="main">
{% if preamble %}
        <section class="preamble">
            {{ preamble }}
        </section>
{% endif %}

        <section>
        {% include "summary.html.jinja2" %}
        </section>

        <section>
            <h2>Tests Summary</h2>
            <table id="test-summary-table" class="summary table--wide resizable-table">
                <thead>
                    <tr>
                        <th>
                            <span>Test Level</span>
                            <select id="level-selector">
                                <option value="all">All</option>
                            {% for level in summary.levels %}
                                <option value={{ level }}>{{ level|capitalize }}</option>
                            {% endfor %}
                            </select>
                        </th>
                        <th>
                            <span>Test ID</span>
                            <input id="filter-id">
                        </th>
                        <th>
                            <span>Test Name</span>
                            <input id="filter"/>
                        </th>
                        <th>Requirements</th>
                        <th>Test Result</th>
                        <th>Issue</th>
                        <th>Bug ID</th>
                        <th>Comment</th>
                    </tr>
                </thead>
                <tbody>

    {% set ns = namespace(refered_requirements=[]) %}
    {% for test_case in tests %}
        {% if test_case.result == "PASSED" -%}
            {% set test_result_class = "test--passed" %}
        {%- elif test_case.result == "SKIPPED" %}
            {% set test_result_class = "test--skipped" %}
        {%- elif test_case.result == "ERRORED" %}
            {% set test_result_class = "test--errored" %}
        {%- elif test_case.result == "FAILED" %}
            {% set test_result_class = "test--failed" %}
        {%- elif test_case.result == "JUSTIFIED" %}
            {% set test_result_class = "test--justified" %}
        {%- elif test_case.result == "EXPECTED-FAILURE" %}
            {% set test_result_class = "test--expected-failure" %}
        {%- elif test_case.result == "UNEXPECTED-SUCCESS" %}
            {% set test_result_class = "test--unexpected-success" %}
        {%- elif test_case.result == "EMPTY" %}
            {% set test_result_class = "test--empty" %}
        {%- else %}
            {% set test_result_class = test_case.result|lower %}
        {%- endif %}

        {% if test_case.level in test_plan_paths: %}
            {% set test_plan_path = test_plan_paths[test_case.level] %}
        {% else %}
            {% set test_plan_path = test_plan_paths['_'] %}
        {% endif %}

        {% if test_case.requirements %}
            {% for requirement in test_case.requirements %}
                {{ ns.refered_requirements.append(requirement)|default("", True) }}
                        <tr class="test_level--{{ test_case.level }} {{ test_result_class }} filterable" data-filter="{{ test_case.test_id }}" data-filter-id="{{ test_case["tags"].get("test-id", [])[0] if test_case["tags"].get("test-id") else "" }}">
                {% if loop.first %}
                            <td class="test__level" rowspan="{{ loop.length }}">{{ test_case.level|capitalize }}</td>
                            <td class="test__id" rowspan="{{ loop.length }}">{{ test_case["tags"].get("test-id", [])[0] if test_case["tags"].get("test-id") else "" }}</td>
                            <td class="test__name" rowspan="{{ loop.length }}"><a href="{{ test_plan_path }}#{{ test_case.test_id_with_level }}">{{ test_case.test_id }}</a></td>
                {% endif %}
                            <td class="test__requirement">{{ requirement }}</td>
                {% if loop.first %}
                            <td class="test__result" rowspan="{{ loop.length }}">
                    {% if test_case.result == 'EMPTY' %}
                    {% else %}
                            <a href="{{ test_case.html_report_path }}#{{ test_case.test_id }}">{{ test_case.result }}</a>
                    {% endif %}
                            </td>
                            <td class="test__issue" rowspan="{{ loop.length }}">
                    {% if test_case.result in ('ERRORED', 'FAILED', 'JUSTIFIED')%}
                            <a href="{{ issue_list_path }}#{{ test_case.test_id_with_level }}">🔗</a>
                    {% endif %}
                            </td>
                            <td class="test__bug-id" rowspan="{{ loop.length }}">
                            {% if test_case.bug_id|length > 1 %}
                                <ul>
                                {% for bug_id in test_case.bug_id %}
                                    <li>{{ bug_id }}</li>
                                {% endfor %}
                                </ul>
                            {% elif test_case.bug_id|length == 1 %}
                                {{ test_case.bug_id[0] }}
                            {% endif %}
                            </td>
                            <td class="test__comment" rowspan="{{ loop.length }}">
                                <div class="scrollable-cell">
                                {% if test_case.comment|length > 1 %}
                                    <ul>
                                    {% for comment in test_case.comment %}
                                        <li>{{ comment }}</li>
                                    {% endfor %}
                                    </ul>
                                {% elif test_case.comment|length == 1 %}
                                    {{ test_case.comment[0] }}
                                {% endif %}
                                </div>
                            </td>
                {% endif %}
                        </tr>
            {% endfor %}
        {% else %}
                <tr class="test_level--{{ test_case.level }} {{ test_result_class }} filterable" data-filter="{{ test_case.test_id }} data-filter-id="{{ test_case["tags"].get("test-id", [])[0] if test_case["tags"].get("test-id") else "" }}">
                    <td class="test__level">{{ test_case.level|capitalize }}</td>
                    <td class="test__id">{{ test_case["tags"].get("test-id", [])[0] if test_case["tags"].get("test-id") else "" }}</td>
                    <td class="test__name"><a href="{{ test_plan_path }}#{{ test_case.test_id }}">{{ test_case.test_id }}</a></td>
                    <td class="test__requirement"></td>
                    <td class="test__result">
                    {% if test_case.result == 'EMPTY' %}
                    {% else %}
                        <a href="{{ test_case.html_report_path }}#{{ test_case.test_id }}">{{ test_case.result }}</a>
                    {% endif %}
                    </td>
                    <td class="test__issue">
                    {% if test_case.result in ('ERRORED', 'FAILED', 'JUSTIFIED')%}
                    <a href="{{ issue_list_path }}#{{ test_case.test_id }}">🔗</a>
                    {% endif %}
                    </td>
                    <td class="test__bug-id">{{ test_case.bug_id }}</td>
                    <td class="test__comment">
                        <div class="scrollable-cell">{{ test_case.comment }}</div>
                    </td>
                </tr>
        {% endif %}
        <tr class="row-resizer">
            <td colspan="8"></td>
        </tr>
    {% endfor %}
                </tbody>
                <tfoot>
                    <tr class="test--{{ summary.result|lower|replace(' ', '-') }}">
                        <th>Total levels: {{ summary.levels.keys()|length }}</th>
                        <th colspan="2">Total tests: {{ summary.results.total }}</th>
                        <th>Total requirements: {{ ns.refered_requirements|unique|list|length }}</th>
                        <th class="test__result">{{ summary.result }}</th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </section>
    </div>

    <script>
        $(document).ready(function() {
            const table = document.getElementById('test-summary-table');
            if (!table) return;

            // Add column resizers with logic after 3rd and 7th column (not generated in template)
            const setupColumnResizers = function (table) {
                const headers = table.querySelectorAll('th');

                const addResizer = function (mainCol, oppositeCol, resizerAnchorCol) {
                    const resizer = document.createElement('div');
                    resizer.classList.add('resizer');
                    resizer.style.height = `${table.offsetHeight}px`;
                    resizerAnchorCol.appendChild(resizer);

                    let startX = 0;
                    let mainStartWidth = 0;
                    let oppositeStartWidth = 0;

                    const mouseDownHandler = function (e) {
                        startX = e.clientX;

                        const mainStyles = window.getComputedStyle(mainCol);
                        const oppositeStyles = window.getComputedStyle(oppositeCol);

                        mainStartWidth = parseInt(mainStyles.width, 10);
                        oppositeStartWidth = parseInt(oppositeStyles.width, 10);

                        document.addEventListener('mousemove', mouseMoveHandler);
                        document.addEventListener('mouseup', mouseUpHandler);

                        resizer.classList.add('resizing');
                    };

                    const mouseMoveHandler = function (e) {
                        const dx = e.clientX - startX;

                        const newMainWidth = mainStartWidth + dx;
                        const newOppositeWidth = oppositeStartWidth - dx;

                        if (newMainWidth > 30 && newOppositeWidth > 30) {
                            mainCol.style.width = `${newMainWidth}px`;
                            oppositeCol.style.width = `${newOppositeWidth}px`;
                        }
                    };

                    const mouseUpHandler = function () {
                        document.removeEventListener('mousemove', mouseMoveHandler);
                        document.removeEventListener('mouseup', mouseUpHandler);
                        resizer.classList.remove('resizing');
                    };

                    resizer.addEventListener('mousedown', mouseDownHandler);
                };
                addResizer(headers[2], headers[7], headers[2]);
                addResizer(headers[2], headers[7], headers[6]);
            };

            // Add event listener to row resizers (already generated in template)
            const setupRowResizers = function(table) {
                const resizers = table.querySelectorAll('.row-resizer');

                resizers.forEach(resizer => {
                    const resizerPreviousRow = resizer.previousElementSibling;
                    if (!resizerPreviousRow) return;

                    const groupIdentifier = resizerPreviousRow.dataset.filter;
                    const rowToResize = table.querySelectorAll(`tr[data-filter="${groupIdentifier}"]`)[0];
                    const firstcell = rowToResize.cells[0];
                    const rowspan = firstcell?.rowSpan ?? 1;
                    const scrollableCell = rowToResize.querySelector(`div[class="scrollable-cell"]`);
                    const scrollableCellMinHeight = parseInt(window.getComputedStyle(scrollableCell).minHeight, 10);

                    let startY = 0;
                    let startRowHeight = 0;
                    let startScrollableColumnHeight = 0;

                    const mouseDownHandler = function(e) {
                        e.preventDefault();
                        startY = e.clientY;
                        startRowHeight = parseInt(window.getComputedStyle(rowToResize).height, 10);
                        startScrollableColumnHeight = parseInt(window.getComputedStyle(scrollableCell).height, 10);
                        document.addEventListener('mousemove', mouseMoveHandler);
                        document.addEventListener('mouseup', mouseUpHandler);
                        resizer.classList.add('resizing');
                    };

                    const mouseMoveHandler = function(e) {
                        const dy = e.clientY - startY;
                        const cellHeight = startScrollableColumnHeight +dy;
                        const rowHeight = cellHeight/rowspan;
                        const scrollableCellMaxHeight = scrollableCell.scrollHeight;

                        if (scrollableCellMaxHeight >= cellHeight && scrollableCellMinHeight <= cellHeight){
                            scrollableCell.style.height = `${cellHeight}px`;

                            let currentRow = rowToResize;
                            for (let i = 0; i < rowspan; i++){
                                currentRow.style.height = `${rowHeight}px`;
                                currentRow = currentRow.nextElementSibling;
                            }
                        }
                    };

                    const mouseUpHandler = function() {
                        document.removeEventListener('mousemove', mouseMoveHandler);
                        document.removeEventListener('mouseup', mouseUpHandler);
                        resizer.classList.remove('resizing');
                    };

                    resizer.addEventListener('mousedown', mouseDownHandler);
                });
            };

            // Add resizer after last column, that will increase table width
            function setupTableResizer(table) {
                const resizer = document.createElement('div');
                resizer.classList.add('resizer');
                resizer.style.height = `${table.offsetHeight}px`;
                const lastHeader = table.querySelectorAll('th')[7];
                lastHeader.appendChild(resizer);

                let startX = 0;
                let startLastColWidth = 0;
                let startTableWidth = 0;

                const mouseDownHandler = function (e) {
                    e.preventDefault();
                    startX = e.clientX;
                    startLastColWidth = lastHeader.offsetWidth;
                    startTableWidth = table.offsetWidth;

                    document.addEventListener('mousemove', mouseMoveHandler);
                    document.addEventListener('mouseup', mouseUpHandler);
                    resizer.classList.add('resizing');
                };

                const mouseMoveHandler = function (e) {
                    const dx = e.clientX - startX;
                    const newLastColWidth = startLastColWidth + dx;
                    const newTableWidth = startTableWidth + dx;

                    table.style.width = `${newTableWidth}px`;
                    lastHeader.style.width = `${newLastColWidth}px`;
                };

                const mouseUpHandler = function () {
                    document.removeEventListener('mousemove', mouseMoveHandler);
                    document.removeEventListener('mouseup', mouseUpHandler);
                    resizer.classList.remove('resizing');
                };

                resizer.addEventListener('mousedown', mouseDownHandler);
            };

            function updateScrollableCells() {
                $(".scrollable-cell").each(function () {
                    const cell = $(this);

                    cell.css("max-height", "1px"); // To not affect calculation (going to be overwritten after calculation)

                    // Calculate default height of other row cells
                    const row = cell.closest("tr");
                    let height = 0;
                    row.children("td:not(.test__comment)").each(function () {
                        const h = $(this).outerHeight();
                        if (h > height) height = h;
                    });

                    cell.css({
                        "height": height + "px",
                    });
                    cell.css({
                        "min-height": height + "px"
                    });
                    cell.css("max-height", "none");

                    // Show scrollbar if needed
                    if (cell[0].scrollHeight > height) {
                        cell.css("overflow-y", "auto");
                    } else {
                        cell.css("overflow-y", "hidden");
                    }
                });
            };

        /* CALL THE SETUP METHODS */
        updateScrollableCells();
        setupRowResizers(table);
        setupColumnResizers(table);
        setupTableResizer(table);
        });
    </script>
</body>

</html>

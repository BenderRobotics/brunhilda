<!doctype html>
<html class="no-js" lang="">

<head>
    <meta charset="utf-8">
    <title>{{ name }}</title>
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
            {% include "themes/base.css" %}
    </style>
</head>

<body class="run-summary">
    <h1>{{ name }}</h1>
    <div class="header">
        {% include "header.html.jinja2" %}
    </div>

    <a href="#index" class="index-link-button">🏠 Home</a>

    <div class="main">
{% if preamble %}
        <section class="preamble">
            {{ preamble }}
        </section>
{% endif %}

        <section>
        {% include "summary.html.jinja2" %}
        </section>

        <section>
            <h2>Tests Summary</h2>
            <table id="test-summary-table" class="summary table--wide resizable-table">
                <thead>
                    <tr>
                        <th>
                            <span>Test Level</span>
                            <select id="level-selector">
                                <option value="all">All</option>
                            {% for level in summary.levels %}
                                <option value={{ level }}>{{ level|capitalize }}</option>
                            {% endfor %}
                            </select>
                        </th>
                        <th>
                            <span>Test ID</span>
                            <span title="Filter supports: & (AND), | (OR), ! (NOT), * (any string), and ? (single character).&#10;Note: & has priority over |." style="vertical-align: middle;">
                                <svg width="16" height="16">
                                    <use href="#icon-info"></use>
                                </svg>
                            </span>
                            <input id="filter-id">
                        </th>
                        <th>
                            <span>Test Name</span>
                            <span title="Filter supports: & (AND), | (OR), ! (NOT), * (any string), and ? (single character).&#10;Note: & has priority over |." style="vertical-align: middle;">
                                <svg width="16" height="16">
                                    <use href="#icon-info"></use>
                                </svg>
                            </span>
                            <input id="filter"/>
                        </th>
                        <th>Requirements</th>
                        <th>Test Result</th>
                        <th>Issue</th>
                        <th>Bug ID</th>
                        <th>Comment</th>
                    </tr>
                </thead>
                <tbody>

    {% set ns = namespace(refered_requirements=[]) %}
    {% for test_case in tests %}
        {% if test_case.result == "PASSED" -%}
            {% set test_result_class = "test--passed" %}
        {%- elif test_case.result == "SKIPPED" %}
            {% set test_result_class = "test--skipped" %}
        {%- elif test_case.result == "ERRORED" %}
            {% set test_result_class = "test--errored" %}
        {%- elif test_case.result == "FAILED" %}
            {% set test_result_class = "test--failed" %}
        {%- elif test_case.result == "JUSTIFIED" %}
            {% set test_result_class = "test--justified" %}
        {%- elif test_case.result == "EXPECTED-FAILURE" %}
            {% set test_result_class = "test--expected-failure" %}
        {%- elif test_case.result == "UNEXPECTED-SUCCESS" %}
            {% set test_result_class = "test--unexpected-success" %}
        {%- elif test_case.result == "NOT-EXECUTED" %}
            {% set test_result_class = "test--not-executed" %}
        {%- else %}
            {% set test_result_class = test_case.result|lower %}
        {%- endif %}

        {% if test_case.level in test_plan_paths: %}
            {% set test_plan_path = test_plan_paths[test_case.level] %}
        {% else %}
            {% set test_plan_path = test_plan_paths['_'] %}
        {% endif %}

        {% if test_case.requirements %}
            {% for req in test_case.requirements %}
                {{ ns.refered_requirements.append(req)|default("", True) }}
            {% endfor %}
        {% endif %}

        {# Rowspan calculation#}
        {% set issue_count = test_case.issues_details | length %}
        {% set has_test_comment = 1 if 'test_comment' in test_case else 0 %}
        {% set has_issue_link = test_case.result in ('ERRORED', 'FAILED', 'JUSTIFIED') %}
        {% set total_rows = [issue_count + has_test_comment, 1] | max %}

        {% for i in range(total_rows) %}
            <tr class="test_level--{{ test_case.level }} {{ test_result_class }} filterable" data-filter="{{ test_case.test_id }}" data-filter-id="{{ test_case["tags"].get("test-id", [])[0] if test_case["tags"].get("test-id") else "" }}">

            {% if i == 0 %}
                <td class="test__level" rowspan="{{ total_rows }}">{{ test_case.level|capitalize }}</td>
                <td class="test__id" rowspan="{{ total_rows }}">{{ test_case["tags"].get("test-id", [])[0] if test_case["tags"].get("test-id") else "" }}</td>
                <td class="test__name" rowspan="{{ total_rows }}"><a href="{{ test_plan_path }}#{{ test_case.test_id_with_level }}">{{ test_case.test_id }}</a></td>
                <td class="test__requirement" rowspan="{{ total_rows }}">
                    {% for req in test_case.requirements %}
                        <div class="req-item">{{ req }}</div>
                    {% endfor %}
                </td>
                <td class="test__result" rowspan="{{ total_rows }}">
                    {% if test_case.result == 'EMPTY' %}
                    {% elif test_case.html_report_path != "" %}
                        <a href="{{ test_case.html_report_path }}#{{ test_case.test_id }}">{{ test_case.result }}</a>
                    {% else %}
                            <a>{{ test_case.result }}</a>
                    {% endif %}
                </td>
            {% endif %}

            {% if i < issue_count %}
                {% if has_issue_link %}
                    {% if test_case.issues_details[i]['result'] == 'ERRORED' %}
                        {% set subtest_class = "subtest--errored" %}
                    {% elif test_case.issues_details[i]['result'] == 'FAILED' %}
                        {% set subtest_class = "subtest--failed" %}
                    {% elif test_case.issues_details[i]['result'] == 'JUSTIFIED' %}
                        {% set subtest_class = "subtest--justified" %}
                    {% endif %}
                <td class="test__issue {{ subtest_class }}">
                    <a href="{{ issue_list_path }}#{{ test_case.issues_details[i]['link'] }}"
                    {% if '(' in test_case.issues_details[i]['link'] and ')' in test_case.issues_details[i]['link'] %}
                    title="{{ test_case.issues_details[i]['link'].split('(')[1].split(')')[0] }}"
                    {% endif %}
                    >🔗 {{ test_case.issues_details[i]['result'][0] }}</a>
                </td>
                {% else %}
                <td class="test__issue"></td>
                {% endif %}
                <td class="test__bug-id">{{ test_case.issues_details[i].get("bug_html_link", test_case.issues_details[i].get("bug_id", "")) | safe }}</td>
                <td class="test__comment">{{ test_case.issues_details[i].get("comment", "") }}</td>
            {% elif loop.last and has_test_comment %}
                <td></td>
                <td></td>
                <td class="test__comment">{{ test_case.test_comment }}</td>
            {% else %}
                <td></td>
                <td></td>
                <td></td>
            {% endif %}
            </tr>
        {% endfor %}
    {% endfor %}
        </tbody>
            <tfoot>
                <tr class="test--{{ summary.result|lower|replace(' ', '-') }}">
                    <th>Total levels: {{ summary.levels.keys()|length }}</th>
                    <th colspan="2">Total tests: {{ summary.results.total }}</th>
                    <th>Total requirements: {{ ns.refered_requirements|unique|list|length }}</th>
                    <th class="test__result">{{ summary.result }}</th>
                    <th></th>
                    <th></th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
        </section>
    </div>

    <script>
        $(document).ready(function() {
            const table = document.getElementById('test-summary-table');
            if (!table) return;

            const resizers = [];

            const updateResizersHeight = () => {
                const currentHeight = table.offsetHeight;

                resizers.forEach(resizer => {
                    resizer.style.top = "0px";
                    resizer.style.height = `${currentHeight}px`;
                });
            };

            // Add column resizers with logic after 3rd and 7th column (not generated in template)
            const setupColumnResizers = function (table) {
                const headers = table.querySelectorAll('th');

                const addResizer = function (mainCol, oppositeCol, resizerAnchorCol) {
                    const resizer = document.createElement('div');
                    resizer.classList.add('resizer');
                    resizer.style.height = `${table.offsetHeight}px`;
                    resizerAnchorCol.appendChild(resizer);
                    resizers.push(resizer);

                    let startX = 0;
                    let mainStartWidth = 0;
                    let oppositeStartWidth = 0;

                    const mouseDownHandler = function (e) {
                        startX = e.clientX;

                        const mainStyles = window.getComputedStyle(mainCol);
                        const oppositeStyles = window.getComputedStyle(oppositeCol);

                        mainStartWidth = parseInt(mainStyles.width, 10);
                        oppositeStartWidth = parseInt(oppositeStyles.width, 10);

                        document.addEventListener('mousemove', mouseMoveHandler);
                        document.addEventListener('mouseup', mouseUpHandler);

                        resizer.classList.add('resizing');
                    };

                    const mouseMoveHandler = function (e) {
                        const dx = e.clientX - startX;

                        const newMainWidth = mainStartWidth + dx;
                        const newOppositeWidth = oppositeStartWidth - dx;

                        if (newMainWidth > 30 && newOppositeWidth > 30) {
                            mainCol.style.width = `${newMainWidth}px`;
                            oppositeCol.style.width = `${newOppositeWidth}px`;
                        }
                    };

                    const mouseUpHandler = function () {
                        document.removeEventListener('mousemove', mouseMoveHandler);
                        document.removeEventListener('mouseup', mouseUpHandler);
                        resizer.classList.remove('resizing');
                        updateResizersHeight();
                    };

                    resizer.addEventListener('mousedown', mouseDownHandler);
                };
                addResizer(headers[2], headers[7], headers[2]);
                addResizer(headers[2], headers[7], headers[6]);
            };

            // Add resizer after last column, that will increase table width
            function setupTableResizer(table) {
                const resizer = document.createElement('div');
                resizer.classList.add('resizer');
                resizer.style.height = `${table.offsetHeight}px`;
                const lastHeader = table.querySelectorAll('th')[7];
                lastHeader.appendChild(resizer);
                resizers.push(resizer);

                let startX = 0;
                let startLastColWidth = 0;
                let startTableWidth = 0;

                const mouseDownHandler = function (e) {
                    e.preventDefault();
                    startX = e.clientX;
                    startLastColWidth = lastHeader.offsetWidth;
                    startTableWidth = table.offsetWidth;

                    document.addEventListener('mousemove', mouseMoveHandler);
                    document.addEventListener('mouseup', mouseUpHandler);
                    resizer.classList.add('resizing');
                };

                const mouseMoveHandler = function (e) {
                    const dx = e.clientX - startX;
                    const newLastColWidth = startLastColWidth + dx;
                    const newTableWidth = startTableWidth + dx;

                    table.style.width = `${newTableWidth}px`;
                    lastHeader.style.width = `${newLastColWidth}px`;
                };

                const mouseUpHandler = function () {
                    document.removeEventListener('mousemove', mouseMoveHandler);
                    document.removeEventListener('mouseup', mouseUpHandler);
                    resizer.classList.remove('resizing');
                    updateResizersHeight();
                };

                resizer.addEventListener('mousedown', mouseDownHandler);
            };


        /* CALL THE SETUP METHODS */
        setupColumnResizers(table);
        setupTableResizer(table);

        updateResizersHeight();

        const observer = new MutationObserver(() => {
            updateResizersHeight();
        });

        observer.observe(table.querySelector('tbody'), {
            attributes: true,
            childList: true,
            subtree: true
        });

        window.addEventListener('resize', updateResizersHeight);
        });
    </script>
</body>

</html>

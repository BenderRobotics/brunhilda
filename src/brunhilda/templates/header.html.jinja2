<p>
    {% if env_info and env_info.name %}<strong>{{ env_info.name }}</strong>{% endif %} generated <time datetime="{{ now().strftime('%Y-%m-%d %H:%M:%S') }}">{{ now().strftime('%Y-%m-%d %H:%M:%S') }}</time> by BRunhilda-{{ brunhilda_version }}
</p>

{% if env_info %}
<h2>Environment</h2>
<table class="testrun__environment">
    <tbody>
        <tr>
            <th>Executed</th>
            <td>{{ env_info.timestamp_start.strftime('%Y-%m-%d %H:%M:%S') }} &ndash;
                {{ env_info.timestamp_finish.strftime('%Y-%m-%d %H:%M:%S') }}</td>
        </tr>
        <tr>
            <th>Python</th><td>{{ env_info.pyversion }}</td>
        </tr>
        <tr>
            <th>System</th><td>{{ env_info.system }}</td>
        </tr>
        <tr>
            <th>Hostname</th><td>{{ env_info.hostname }}</td>
        </tr>
    </tbody>
</table>
{% endif %}

{% if user_data %}
<h2>User data</h2>
<table class="testrun__user_data">
    <tbody>
        {% for key, value in user_data.items() %}
        <tr>
            <th>{{ key }}</th>
            <td>{{ value }}</td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% endif %}

<script id="color_palette">
    const colorPaletteTestResult = {
        passed: 'green',
        failed: '#dc0000',
        errored: '#a700d1',
        justified: 'orange',
        skipped: '#74ad09',
        expectedFailure: '#4000f0',
        unexpectedSuccess: '#00c8c8',
        notExecuted: '#808080'
    };

    const colorPaletteTestExecution = {
        automatic: 'CornflowerBlue',
        manual: '#64D8ED',
        notspecified: '#7964ED'
    };

    const colorPaletteTestLevels = {
        component: 'CornflowerBlue',
        module: 'Chocolate',
        system: 'Coral',
        visual: 'DarkKhaki',
        integration: 'DarkCyan'
    };
</script>

<svg style="display: none;" xmlns="http://www.w3.org/2000/svg">
    <symbol id="icon-out-of-scope-reason" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="10" fill="currentColor"></circle>
        <g stroke="white" stroke-width="3" stroke-linecap="round">
            <line x1="12" y1="17" x2="12" y2="11"></line>
            <line x1="12" y1="7" x2="12" y2="7"></line>
        </g>
    </symbol>
</svg>

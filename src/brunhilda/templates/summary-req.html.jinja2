<!doctype html>
<html class="no-js" lang="">

<head>
    <meta charset="utf-8">
    <title>{{ name }}</title>
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
    {% include "themes/base.css" %}
    </style>
</head>

<body class="run-summary">
    <h1>{{ name }}</h1>
    <div class="header">
        {% include "header.html.jinja2" %}
    </div>

    <div class="top-right-controls">
        <a href="#index" class="btn">🏠 Home</a>
    </div>

    <div class="main">
{% if preamble %}
        <section class="preamble">
            {{ preamble }}
        </section>
{% endif %}

        <section>
        {% include "summary.html.jinja2" %}
        </section>

        <section>
        <h2>Summary</h2>
        <table class="run-summary table--wide">
            <tbody>
                <tr class="run-summary--passed">
                    <th>
                        <input type="checkbox" id="req-summary--passed" checked>
                        <label for="req-summary--passed">Passed</label>
                    </th>
                    <td>
                        {{ requirements_results.passed }}
                    </td>
                    <td>All tests of the requirement passed.</td>
                </tr>
                <tr class="run-summary--failed">
                    <th>
                        <input type="checkbox" id="req-summary--failed" checked>
                        <label for="req-summary--failed">Failed</label>
                    </th>
                    <td>
                        {{ requirements_results.failed }}
                    </td>
                    <td>At least one test of the requirement failed.</td>
                </tr>
                <tr class="run-summary--errored">
                    <th>
                        <input type="checkbox" id="req-summary--errored" checked>
                        <label for="req-summary--errored">Errored</label>
                    </th>
                    <td>
                        {{ requirements_results.errored }}
                    </td>
                    <td>At least one test of the requirement errored.</td>
                </tr>
                <tr class="run-summary--justified">
                    <th>
                        <input type="checkbox" id="req-summary--justified" checked>
                        <label for="req-summary--justified">Justified</label>
                    </th>
                    <td>
                        {{ requirements_results.justified }}
                    </td>
                    <td>All failed or erored requirement tests were justified.</td>
                </tr>
                <tr class="run-summary--skipped">
                    <th>
                        <input type="checkbox" id="req-summary--skipped" checked>
                        <label for="req-summary--skipped">Skipped</label>
                    </th>
                    <td>
                        {{ requirements_results.skipped }}
                    </td>
                    <td>All requirement tests were skipped.</td>
                </tr>
                <tr class="run-summary--expected-failure">
                    <th>
                        <input type="checkbox" id="req-summary--expected-failure" checked>
                        <label for="req-summary--expected-failure">Expected failures</label>
                    </th>
                    <td>
                        {{ requirements_results.expected_failures }}
                    </td>
                    <td>All requirement tests failed are expected to fail during execution.</td>
                </tr>
                <tr class="run-summary--unexpected-success">
                    <th>
                        <input type="checkbox" id="req-summary--unexpected-success" checked>
                        <label for="req-summary--unexpected-success">Unexpected successes</label>
                    </th>
                    <td>
                        {{ requirements_results.unexpected_successes }}
                    </td>
                    <td>At least one requirement test marked as <em>expected failure</em> which passed despite expectation.</td>
                </tr>
                <tr class="run-summary--not-executed">
                    <th>
                        <input type="checkbox" id="req-summary--not-covered" checked>
                        <label for="req-summary--not-covered">Not covered</label>
                    </th>
                    <td>
                        {{ requirements_results.not_executed }}
                    </td>
                    <td>No tests are linked to the requirement.</td>
                </tr>
                <tr class="run-summary--out-of-scope">
                    <th>
                        <input type="checkbox" id="req-summary--out-of-scope" checked>
                        <label for="req-summary--out-of-scope">Out of scope</label>
                    </th>
                    <td>
                        {{ requirements_results.out_of_scope }}
                    </td>
                    <td>Requirement is marked as out of scope.</td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <th> Total </th>
                    <td colspan="2">{{ requirements_results.total }}</td>
                </tr>
            </tfoot>
        </table>

        <script src="https://www.gstatic.com/charts/loader.js"></script>
        <script>
            google.charts.load('current', {'packages': ['corechart']});
            google.charts.setOnLoadCallback(drawChart);

            function drawChart() {
                var dataResult = google.visualization.arrayToDataTable([
                    ['Requirement result', 'Amount'],
                    ['passed', {{ requirements_results.passed }}],
                    ['failed', {{ requirements_results.failed }}],
                    ['errored', {{ requirements_results.errored }}],
                    ['skipped', {{ requirements_results.skipped }}],
                    ['justified', {{ requirements_results.justified }}],
                    ['expected failure', {{ requirements_results.expected_failures }}],
                    ['unexpected success', {{ requirements_results.unexpected_successes }}],
                    ['not covered', {{ requirements_results.not_executed }}],
                    ['out of scope', {{ requirements_results.out_of_scope }}]
                ]);

                var chartResult = new google.visualization.PieChart(document.getElementById('piechart_result'));

                chartResult.draw(dataResult, {
                    title: 'Requirements Result',
                    chartArea: {width: '95%', height: '80%'},
                    pieHole: 0.3,
                    colors: ['green','#dc0000', '#a700d1', 'orange', '#74ad09', '#4000f0', '#00c8c8', '#dddddd', '#6F4E37'],
                    pieSliceTextStyle: {color: 'black'}
                });
            }
        </script>
        <div class="piechart">
            <div id="piechart_result" class="piechart__chart"></div>
        </div>
        </section>

        <section>
            <h2>Requirements Summary</h2>
            <table class="summary table--wide">
                <thead>
                    <tr>
                        <th class="table__col--test_requirement">
                            <span>Requirement ID</span>
                            <span title="Filter supports: & (AND), | (OR), ! (NOT), * (any string), and ? (single character).&#10;Note: & has priority over |." style="vertical-align: middle;">
                                <svg width="16" height="16">
                                    <use href="#icon-info"></use>
                                </svg>
                            </span>
                            <input id="filter"/>
                        </th>
                        <th class="table__col--req_result">Requirement Result</th>
                        <th class="table__col--test_level">
                            <span>Test Level</span>
                            <select id="level-selector">
                                <option value="all">All</option>
                            {% for level in summary.levels %}
                                <option value={{ level }}>{{ level|capitalize }}</option>
                            {% endfor %}
                            </select>
                        </th>
                        <th class="table__col--req_name">Test Cases Covering Requirement</th>
                        <th class="table__col--cov_p">Requirement Coverage Percentage/Test Case</th>
                        <th class="table__col--test_result">Test Result</th>
                        <th>Requirement Pass Percentage</th>
                    </tr>
                </thead>
                <tbody>
                {% for requirement in requirements %}
                    <tr class="filterable" data-filter="{{ requirement.name }}">
                        <td class="req__id table__col--test_requirement">{{ requirement.name }}</td>
                        {% if requirement.out_of_scope != None %}
                        <td class="table__col--requirement_result req--out-of-scope">OUT OF SCOPE
                                    {% if requirement.out_of_scope != "" %}
                                        <span title="{{ requirement.out_of_scope }}" style="vertical-align: middle;">
                                        <svg width="16" height="16">
                                            <use href="#icon-info"></use>
                                        </svg>
                                    </span>
                                    {% endif %}
                        </td>
                        {% elif requirement.levels|length == 0 %}
                        <td class="table__col--requirement_result req--not-covered">NOT COVERED</td>
                        {% else %}
                            {% if requirement.result == "PASSED" -%}
                                {% set req_result_class = "req--passed" %}
                            {%- elif requirement.result == "SKIPPED" %}
                                {% set req_result_class = "req--skipped" %}
                            {%- elif requirement.result == "ERRORED" %}
                                {% set req_result_class = "req--errored" %}
                            {%- elif requirement.result == "FAILED" %}
                                {% set req_result_class = "req--failed" %}
                            {%- elif requirement.result == "JUSTIFIED" %}
                                {% set req_result_class = "req--justified" %}
                            {%- elif requirement.result == "EXPECTED-FAILURE" %}
                                {% set req_result_class = "req--expected-failure" %}
                            {%- elif requirement.result == "UNEXPECTED-SUCCESS" %}
                                {% set req_result_class = "req--unexpected-success" %}
                            {%- else %}
                                {% set test_result_class = requirement.result|lower %}
                            {%- endif %}
                        <td class="table__col--requirement_result {{ req_result_class }}">{{ requirement.result }}</td>
                        {% endif %}
                        <td class="inner_table__td" colspan="4">
                            <table class="inner_table">
                            <tbody>
                    {% if requirement.out_of_scope != None or requirement.levels|length == 0 %}
                        <tr></tr>
                    {% else %}
                        {% for level_name, level_tests in requirement.levels.items() -%}
                            {% set level_loop = loop %}
                            {% for test_case in level_tests -%}
                                {% if test_case.result == "PASSED" -%}
                                    {% set test_result_class = "test--passed" %}
                                {%- elif test_case.result == "SKIPPED" %}
                                    {% set test_result_class = "test--skipped" %}
                                {%- elif test_case.result == "ERRORED" %}
                                    {% set test_result_class = "test--errored" %}
                                {%- elif test_case.result == "FAILED" %}
                                    {% set test_result_class = "test--failed" %}
                                {%- elif test_case.result == "JUSTIFIED" %}
                                    {% set test_result_class = "test--justified" %}
                                {%- elif test_case.result == "EXPECTED-FAILURE" %}
                                    {% set test_result_class = "test--expected-failure" %}
                                {%- elif test_case.result == "UNEXPECTED-SUCCESS" %}
                                    {% set test_result_class = "test--unexpected-success" %}
                                {%- elif test_case.result == "NOT-EXECUTED" %}
                                    {% set test_result_class = "test--not-executed" %}
                                {%- else %}
                                    {% set test_result_class = test_case.result|lower %}
                                {%- endif %}

                                {% if level_name in test_plan_paths: %}
                                    {% set test_plan_path = test_plan_paths[level_name] %}
                                {% else %}
                                    {% set test_plan_path = test_plan_paths['_'] %}
                                {% endif %}

                                <tr class="{{ test_result_class }} test_level--{{ level_name }}">
                                    <td class="req__test-level testcase__inner_table__td table__col--test_level" >{{ level_name|capitalize }}</td>
                                    <td class="req__test-id testcase__inner_table__td table__col--req_name">
                                        <a href="{{ test_plan_path }}#{{ test_case.test_id_with_level }}">{{ test_case.test_id }}</a>
                                    </td>
                                    <td class="req__test-coverage testcase__inner_table__td table__col--cov_p">{{ (100 / requirement.count)|round|int }}</td>
                                    <td class="{{ test_result_class }} req__test-result testcase__inner_table__td table__col--test_result">
                                        <span class="test__result">
                                    {% if test_case.result not in ('SKIPPED', 'PASSED', 'EXPECTED-FAILURE', 'UNEXPECTED-SUCCESS', 'NOT-EXECUTED') %}
                                            <a href="{{ issue_list_path }}#{{ test_case.test_id_with_level }}">{{ test_case.result }}</a>
                                    {% else %}
                                            {{ test_case.result }}
                                    {% endif %}
                                        </span>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endfor %}
                    {% endif %}
                            </tbody>
                            </table>
                        </td>
                        <td class="req__coverage"> {% if requirement.out_of_scope != None %} 100 {% else %}{{ requirement.pass_ratio|round|int }} {% endif %}</td>
                    </tr>
                {% endfor %}
                </tbody>
                <tfoot>
                    <tr class="test--{{ summary.result|lower|replace(' ', '-') }}">
                        <th>Total requirements: {{ requirements_results.total }}</th>
                        <th></th>
                        <th>Total levels: {{ summary.levels.keys()|length }}</th>
                        <th colspan="4">Total tests: {{ summary.results.total }}</th>

                    </tr>
                </tfoot>
            </table>
        </section>
    </div>
</body>

<script>
    $(document).ready(function() {
        const req_types = ['not-covered', 'out-of-scope', 'passed', 'failed', 'errored', 'justified', 'skipped', 'expected-failure', 'unexpect-success'];

        for (const type of req_types) {
            (function(t) {
                const checkboxId = "#req-summary--" + t;

                if ($(checkboxId).length) {
                    $(checkboxId).change(function() {
                        const rowsToToggle = $("tr.filterable").has("td.req--" + t);

                        if (this.checked) {
                            rowsToToggle.removeClass("req--hidden");
                        } else {
                            rowsToToggle.addClass("req--hidden");
                        }
                    });
                }
            })(type);
        }

        function evaluateRequirementsVisibility() {
            setTimeout(function() {
                const currentLevel = $("#level-selector").val();

                $("tr.filterable").each(function() {
                    const $row = $(this);
                    const $innerTable = $row.find(".inner_table");

                    if ($innerTable.length) {
                        const totalTests = $innerTable.find("tbody tr").length;
                        const hiddenTests = $innerTable.find("tbody tr.test--hidden_lvl").length;

                        const allTestsHidden = totalTests > 0 && totalTests === hiddenTests;
                        const hasNoTests = $innerTable.find("tbody tr td").length === 0;
                        const shouldHideEmptyReq = hasNoTests && currentLevel !== "all";

                        if (shouldHideEmptyReq || allTestsHidden) {
                            $row.addClass("req--hidden_lvl");
                        } else {
                            $row.removeClass("req--hidden_lvl");
                        }
                    }
                });
            }, 0);
        }

        $("#level-selector").on("change", evaluateRequirementsVisibility);
        $('.run-summary input[type="checkbox"]').on("change", evaluateRequirementsVisibility);

        evaluateRequirementsVisibility();
    });

</script>

</html>

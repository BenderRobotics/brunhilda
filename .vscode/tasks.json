{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "static-type-check",
            "type": "shell",
            "command": "mypy src/brunhilda",
            "problemMatcher": []
        },
        {
            "label": "test-with-coverage",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m",
                "pytest",
                "--cov=src",
                "test"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$python"
        },
        {
            "label": "integration-tests",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m",
                "pytest",
                "test/integration"
            ],
            "group": {
                "kind": "test"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$python"
        }
    ]
}

{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "test-lint",
            "type": "shell",
            "command": "mypy src/brunhilda",
            "problemMatcher": []
        },
        {
            "label": "test-unit",
            "type": "shell",
            "command": "source ${workspaceFolder}/venv/bin/activate && pytest test/unit --pyargs --tb=short --cov=. --cov-config=.coveragerc --cov-report html --cov-report term:skip-covered -s --junitxml=.coverage_html/junit.xml",
            "windows": {
                "command": "${workspaceFolder}/venv/Scripts/activate.bat; pytest test/unit --pyargs --tb=short --cov=. --cov-config=.coveragerc --cov-report html --cov-report term:skip-covered -s --junitxml=.coverage_html/junit.xml"
            },
            "problemMatcher": []
        }
    ]
}

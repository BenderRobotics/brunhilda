<!doctype html>
<html class="no-js" lang="">

<head>
    <meta charset="utf-8">
    <title>Test Run Summary {% if env_info.name %}[{{ env_info.name }}]{% endif %}</title>
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
            {% include "themes/base.css" %}
    </style>
</head>

<body>
    <h1>Test Run Summary {% if env_info.name %}<strong>[{{ env_info.name }}]</strong>{% endif %}</h1>
    <div class="header">
        {% include "header.html.jinja2" %}
    </div>
    <div class="main">
{% if preamble %}
        <section class="preamble">
            {{ preamble }}
        </section>
{% endif %}
        <section>
            <h2>Tests Summary</h2>

            {% include "summary.html.jinja2" %}

            <table class="summary table--wide">
                <thead>
                    <tr>
                        <th>Test ID</th>
                        <th>Requirements</th>
                        <th>Test Result</th>
                        <th>Bug ID</th>
                        <th>Comment</th>
                    </tr>
                </thead>
                <tbody>
{% for test in tests %}
    {% for requirement in test.requirements %}
        {% if loop.first %}
                <tr class="test--{{ test.result|lower|replace(' ', '-') }}">
        {% else %}
                <tr>
        {% endif %}
        {% if loop.first %}
                    <td class="test__id" rowspan="{{ loop.length }}"><a href="{{ paths.test_plan }}#test--{{ test.test_id }}">{{ test.test_id }}</a></td>
        {% endif %}
                    <td class="test__requirement">{{ requirement }}</td>
        {% if loop.first %}
                    <td class="test__result" rowspan="{{ loop.length }}"><a href="{{ paths.test_record }}#test--{{ test.test_id }}">{{ test.result }}</a></td>
                    <td class="test__bug-id" rowspan="{{ loop.length }}"><input type="text" name="{{ test.test_id }}--bug" id="{{ test.test_id }}--bug" /></td>
                    <td class="test__comment" rowspan="{{ loop.length }}"><div contenteditable class="textarea">{{ test.comment }}</div></td>
        {% endif %}
                </tr>
    {% endfor %}
{% endfor %}
                </tbody>
                <tfoot>
                    <tr class="test--{{ summary.result|lower|replace(' ', '-') }}">
                        <th>Total tests: {{ summary.tests }}</th>
                        <th>Total requirements: {{ summary.requirements }}</th>
                        <th class="test__result">{{ summary.result }}</th>
                        <th></th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </section>
    </div>
</body>

</html>